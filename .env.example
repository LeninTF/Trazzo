# Plantilla de variables para PRODUCCION (docker-compose.yml lee este fichero como .env).
# Copiar a .env y completar. NUNCA commitear valores: aqui solo van los nombres.
# Formato de cada comentario: obligatoria|opcional - consumidor - formato.

# ---- Postgres (docker-compose.yml, docker/postgres/init/01-init-master-db.sh) ----
# obligatoria - servicio trazzo-db y trazzo-db-bootstrap - nombre del superusuario de Postgres
POSTGRES_USER=
# obligatoria - trazzo-db y trazzo-db-bootstrap (PGPASSWORD) - contrasena del superusuario
POSTGRES_SUPERUSER_PASSWORD=
# obligatoria - trazzo-db (POSTGRES_DB) - BD inicial del cluster, p.ej. postgres
POSTGRES_DB=
# obligatoria - init script y backend (DB_URL) - nombre de la BD master de la app
APP_DB_NAME=
# obligatoria - init script y backend (DB_USER) - rol de la app, sin superusuario
APP_DB_USER=
# obligatoria - init script y backend (DB_PASSWORD) - contrasena del rol de la app
APP_DB_PASSWORD=
# opcional - trazzo-db-ssh - zona horaria del contenedor SSH, p.ej. UTC (BD y backend fijan UTC en el compose)
# TZ=

# ---- Tunel SSH a la BD (docker-compose.yml, servicio trazzo-db-ssh) ----
# obligatoria - trazzo-db-ssh - usuario SSH
SSH_USERNAME=
# obligatoria - trazzo-db-ssh - clave publica SSH en una linea (ssh-ed25519 AAAA...)
SSH_PUBLIC_KEY=
# opcional - solo si se reactiva cloudflared (comentado en el compose) - token del tunel de Cloudflare
# TUNNEL_TOKEN=

# ---- Backend: seguridad (application.properties) ----
# obligatoria - JwtService (app.jwt.secret) - HMAC-256 en Base64, minimo 32 bytes
APP_JWT_SECRET=
# obligatoria - EncryptionService (app.encryption.key) - AES-256-GCM, Base64 de 32 bytes
APP_ENCRYPTION_KEY=

# ---- Backend: clave RSA biometrica (application.properties, RsaKeyProviderAdapter) ----
# El compose ya fija APP_BIOMETRIC_RSA_KEY_FILE=/app/keys/biometric-rsa.pem (volumen trazzo-backend-keys):
# la clave se genera la primera vez y sobrevive a los reinicios. Respaldar ese volumen con la BD.
# opcional - tiene prioridad sobre el archivo - clave privada RSA-2048 PKCS#8 en PEM (\n literales) o Base64
# APP_BIOMETRIC_RSA_PRIVATE_KEY=
# opcional - claves anteriores tras rotar, separadas por comas - PKCS#8 en Base64
# APP_BIOMETRIC_RSA_PREVIOUS_KEYS=

# ---- Backend: URLs (application.properties) ----
# obligatoria en prod - AppConfigPort (app.frontend-url) - URL https publica del frontend, sin barra final
FRONTEND_URL=

# ---- Backend: Mercado Pago (application.properties) ----
# obligatoria en prod si MERCADOPAGO_REQUIRED=true - MercadoPago adapters - access token de la cuenta
MERCADOPAGO_ACCESS_TOKEN=
# opcional - MercadoPago adapters (mercadopago.public-key) - public key de la cuenta
# MERCADOPAGO_PUBLIC_KEY=
# obligatoria en prod si MERCADOPAGO_REQUIRED=true - webhook controller - secreto de firma del webhook
MERCADOPAGO_WEBHOOK_SECRET=
# opcional - StartupConfigValidator - true|false, default true; en prod debe quedar true
# MERCADOPAGO_REQUIRED=
# opcional - checkout - true|false, default false; en prod debe quedar false (sandbox rompe el arranque)
# MERCADOPAGO_USE_SANDBOX=
# opcional - back_url del checkout - URL https, default = FRONTEND_URL
# MERCADOPAGO_BACK_URL=

# ---- Backend: tareas programadas (application.properties) ----
# opcional - limpieza de trials /shop abandonados - horas enteras, default 1
# ABANDONED_TRIAL_HOURS=
# opcional - cron de esa limpieza - cron de Spring de 6 campos, default "0 0 * * * *"
# ABANDONED_TRIAL_CLEANUP_CRON=

# ---- Backend: almacenamiento Cloudflare R2 (application.properties) ----
# opcional - si el endpoint esta vacio no se crean los beans de storage - URL https del endpoint S3 de R2
# CLOUDFLARE_R2_ENDPOINT=
# opcional - region del cliente S3 - normalmente auto
# CLOUDFLARE_R2_REGION=
# opcional - credencial R2 - access key id
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# opcional - credencial R2 - secret access key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# opcional - nombre del bucket
# CLOUDFLARE_R2_BUCKET_NAME=
# opcional - URL publica base de los objetos - URL https
# CLOUDFLARE_R2_PUBLIC_URL=

# ---- Backend: email (application.properties) ----
# opcional - ResendEmailAdapter - API key de Resend; vacia = no se envian correos
# RESEND_API_KEY=
# opcional - remitente de los correos - email, default notificaciones@trazzo.pe
# RESEND_FROM_EMAIL=
# opcional - destino de avisos de solicitudes - email, default solicitudes@trazzo.pe
# REQUESTS_NOTIFICATION_EMAIL=

# ---- Backend: pool y migraciones (application.properties) ----
# opcional - Hikari del master (maximum-pool-size) - entero, default 10
# DB_POOL_MAX=
# opcional - TenantSchemaMigrator - true|false, default false (registra ERROR y sigue)
# TENANT_MIGRATIONS_FAIL_ON_ERROR=

# ---- Seeders (application.properties): INERTES fuera del perfil local; dejar vacios en prod ----
# opcional - DataSeeder - email del admin semilla
# TRAZZO_SEED_ADMIN_EMAIL=
# opcional - DataSeeder - contrasena del admin semilla
# TRAZZO_SEED_ADMIN_PASSWORD=
# opcional - TenantDataSeeder - email del usuario demo
# TRAZZO_SEED_TENANT_DEMO_EMAIL=
# opcional - TenantDataSeeder - contrasena del usuario demo
# TRAZZO_SEED_TENANT_DEMO_PASSWORD=
# opcional - TenantDataSeeder - email del usuario "usuario"
# TRAZZO_SEED_TENANT_USUARIO_EMAIL=
# opcional - TenantDataSeeder - contrasena del usuario "usuario"
# TRAZZO_SEED_TENANT_USUARIO_PASSWORD=
