{
  "Agent": {
    "AllowLocalDevelopmentOrigins": true
  },
  "Backend": {
    "BaseUrl": "http://localhost:8080/api/v1"
  },
  "Biometric": {
    "IncludeFingerprintImageInResponses": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Enrollment": {
    "AllowLocalWebSocketEnrollment": true
  }
}
