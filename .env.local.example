# Plantilla para LOCAL (docker-compose.local.yml). Copiar a .env.local (ignorado por git).
# Arrancar con: docker compose --env-file .env.local -f docker-compose.local.yml up -d --build
# NUNCA commitear valores: aqui solo van los nombres.
# Formato de cada comentario: obligatoria|opcional - consumidor - formato.

# ---- Postgres (docker-compose.local.yml, docker/postgres/init/01-init-master-db.sh) ----
# obligatoria - postgres-local y trazzo-db-bootstrap - nombre del superusuario (p.ej. postgres)
POSTGRES_USER=
# obligatoria - postgres-local y trazzo-db-bootstrap (PGPASSWORD) - contrasena del superusuario
POSTGRES_SUPERUSER_PASSWORD=
# obligatoria - postgres-local (POSTGRES_DB) - BD inicial del cluster, p.ej. postgres
POSTGRES_DB=
# obligatoria - init script y backend (DB_URL) - nombre de la BD master local
APP_DB_NAME=
# obligatoria - init script y backend (DB_USER) - rol de la app, sin superusuario
APP_DB_USER=
# obligatoria - init script y backend (DB_PASSWORD) - contrasena del rol de la app
APP_DB_PASSWORD=
# opcional - zona horaria de herramientas del host; los contenedores fijan UTC en el compose
# TZ=

# ---- Backend: seguridad (application.properties) ----
# obligatoria - JwtService (app.jwt.secret) - HMAC-256 en Base64, minimo 32 bytes
APP_JWT_SECRET=
# obligatoria - EncryptionService (app.encryption.key) - AES-256-GCM, Base64 de 32 bytes
APP_ENCRYPTION_KEY=

# ---- Backend: clave RSA biometrica (RsaKeyProviderAdapter) ----
# docker-compose.local.yml la guarda en el volumen trazzo-backend-keys-local; no hace falta definir nada.
# opcional - fuerza una clave concreta - PKCS#8 en PEM (\n literales) o Base64
# APP_BIOMETRIC_RSA_PRIVATE_KEY=
# opcional - clave AES-256 (Base64 de 32 bytes) de las huellas guardadas; vacia = APP_ENCRYPTION_KEY
# APP_BIOMETRIC_STORAGE_KEY=

# ---- Backend: URLs (application*.properties) ----
# opcional - app.frontend-url - URL del frontend local, default http://localhost:4000
# FRONTEND_URL=

# ---- Backend: Mercado Pago (application*.properties) ----
# opcional en local - access token de pruebas; vacio = checkout deshabilitado (mercadopago.required=false)
# MERCADOPAGO_ACCESS_TOKEN=
# opcional - public key de pruebas
# MERCADOPAGO_PUBLIC_KEY=
# opcional - secreto de firma del webhook; vacio = el webhook rechaza todo
# MERCADOPAGO_WEBHOOK_SECRET=
# opcional - true|false; el perfil local lo fija en false
# MERCADOPAGO_REQUIRED=
# opcional - true|false; el perfil local lo fija en true
# MERCADOPAGO_USE_SANDBOX=
# opcional - back_url del checkout - URL https (MP rechaza localhost), default = FRONTEND_URL
# MERCADOPAGO_BACK_URL=

# ---- Backend: tareas programadas (application.properties) ----
# opcional - horas enteras, default 1
# ABANDONED_TRIAL_HOURS=
# opcional - cron de Spring de 6 campos, default "0 0 * * * *"
# ABANDONED_TRIAL_CLEANUP_CRON=

# ---- Backend: almacenamiento Cloudflare R2 (application*.properties) ----
# opcional - vacio = LocalStorageStub - URL https del endpoint S3 del R2 de DEV
# CLOUDFLARE_R2_ENDPOINT=
# opcional - region, default auto en local
# CLOUDFLARE_R2_REGION=
# opcional - access key id (cuenta R2 de DEV, nunca la de prod)
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# opcional - secret access key (cuenta R2 de DEV)
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# opcional - bucket, default trazzo-dev en local
# CLOUDFLARE_R2_BUCKET_NAME=
# opcional - URL publica base de los objetos - URL https
# CLOUDFLARE_R2_PUBLIC_URL=

# ---- Backend: email (application*.properties) ----
# opcional - API key de Resend; vacia = no se envian correos
# RESEND_API_KEY=
# opcional - remitente - email, default notificaciones@trazzo.pe
# RESEND_FROM_EMAIL=
# opcional - email, default solicitudes@trazzo.pe
# REQUESTS_NOTIFICATION_EMAIL=

# ---- Backend: pool y migraciones (application.properties) ----
# opcional - Hikari del master (maximum-pool-size) - entero, default 10
# DB_POOL_MAX=
# opcional - TenantSchemaMigrator - true|false; local y tests lo fijan en true
# TENANT_MIGRATIONS_FAIL_ON_ERROR=

# ---- Seeders (solo perfil local) ----
# obligatoria - DataSeeder - email del admin semilla, default admin@trazzo.pe
TRAZZO_SEED_ADMIN_EMAIL=
# obligatoria - DataSeeder - contrasena del admin semilla
TRAZZO_SEED_ADMIN_PASSWORD=
# obligatoria - TenantDataSeeder - email del usuario demo, default demo@trazzo.pe
TRAZZO_SEED_TENANT_DEMO_EMAIL=
# obligatoria - TenantDataSeeder - contrasena del usuario demo
TRAZZO_SEED_TENANT_DEMO_PASSWORD=
# obligatoria - TenantDataSeeder - email del usuario "usuario", default usuario@trazzo.pe
TRAZZO_SEED_TENANT_USUARIO_EMAIL=
# obligatoria - TenantDataSeeder - contrasena del usuario "usuario"
TRAZZO_SEED_TENANT_USUARIO_PASSWORD=
